# ---------------------------------------------------------------------------
# RepoOps environment template
#
# Copy to .dev.vars for local `wrangler dev`, and set the same keys as Worker
# secrets in production (`wrangler secret put <NAME>`). Values below are
# placeholders only — never commit real credentials.
# ---------------------------------------------------------------------------

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL must be: <your-origin>/api/auth/callback
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret

# 32+ random bytes, used to encrypt stored OAuth tokens with AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_string

# Required only for the public demo cache when GitHub's anonymous quota is tight.
# A read-only token with `public_repo` is enough. Optional.
GITHUB_TOKEN=

# Absolute public origin of the deployment; used to build the OAuth redirect_uri.
# Leave unset to derive it from the incoming request.
APP_ORIGIN=https://repoops.example.workers.dev
