# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep shell scripts LF even on Windows.
*.sh text eol=lf

# Lockfile diffs are noise in review.
package-lock.json linguist-generated=true
