{
  "name": "repoops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RepoOps — the war room for open-source maintainers",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "worker:dev": "wrangler dev --port 8787 --local",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply repoops-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply repoops-db --remote",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node tests/integration/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
